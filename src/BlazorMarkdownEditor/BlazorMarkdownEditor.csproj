<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- NuGet package metadata -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>BlazorMarkdownEditor</PackageId>
    <!-- Version is set by CI from the git tag (v1.2.3 → -p:Version=1.2.3); local builds use the SDK default. -->
    <Authors>itree informatik GmbH</Authors>
    <Company>itree informatik GmbH</Company>
    <Product>BlazorMarkdownEditor</Product>
    <Description>A lightweight Markdown editor component for Blazor with Write/Preview tabs and a formatting toolbar — similar to the GitHub issue editor. No third-party UI or NuGet dependencies; Markdown rendering is built in, syntax highlighting uses a bundled copy of highlight.js (BSD-3-Clause). English defaults that can be overridden for full localization.</Description>
    <PackageTags>blazor;markdown;editor;component;razor;markdown-editor;wasm</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/itree-informatik/BlazorMarkdownEditor</PackageProjectUrl>
    <RepositoryUrl>https://github.com/itree-informatik/BlazorMarkdownEditor</RepositoryUrl>
    <PackageReleaseNotes>https://github.com/itree-informatik/BlazorMarkdownEditor/releases</PackageReleaseNotes>
  </PropertyGroup>

  <!-- Deterministic, debuggable builds: embed the PDB so consumers get SourceLink stepping
       (SourceLink for GitHub is on by default in the .NET SDK) and normalize paths on CI. -->
  <PropertyGroup>
    <DebugType>embedded</DebugType>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.8" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
